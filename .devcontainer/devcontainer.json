{
  "name": "Kubernetes & Pixie Dev Environment",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "enableNonRootDocker": "true",
      "moby": false
    },
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "latest",
      "minikube": "latest",
      "helm": "latest",
      "kubectl": "latest"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "stateful.runme"
      ]
    }
  },
  "postCreateCommand": "echo here"
}